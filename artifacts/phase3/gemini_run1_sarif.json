{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ArgusV2",
          "version": "2.1.0",
          "informationUri": "https://gitlab.com",
          "rules": [
            {
              "id": "argus/vulnerable",
              "name": "Argus Vulnerability",
              "shortDescription": {
                "text": "Canonical obligations failed"
              },
              "fullDescription": {
                "text": "Argus could not prove one or more obligations."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "argus/unverified",
              "name": "Argus Unverified",
              "shortDescription": {
                "text": "Verification was inconclusive"
              },
              "fullDescription": {
                "text": "Argus could not verify due to unsupported constructs or guard failures."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "argus/error",
              "name": "Argus Verification Error",
              "shortDescription": {
                "text": "Tooling/runtime verification error"
              },
              "fullDescription": {
                "text": "Argus encountered a verifier/runtime error and failed closed."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ],
          "properties": {
            "provider": "gemini",
            "model": "gemini-2.5-pro"
          }
        }
      },
      "results": [
        {
          "ruleId": "argus/unverified",
          "level": "warning",
          "message": {
            "text": "Assumption evidence validation failed"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "safe/saturating_withdrawal.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "argus_verdict": "UNVERIFIED",
            "engine": "lean",
            "obligation_count": 1
          }
        },
        {
          "ruleId": "argus/unverified",
          "level": "warning",
          "message": {
            "text": "Assumption evidence validation failed"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "vulnerable/negative_withdrawal.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "argus_verdict": "UNVERIFIED",
            "engine": "lean",
            "obligation_count": 1
          }
        },
        {
          "ruleId": "argus/unverified",
          "level": "warning",
          "message": {
            "text": "Assumption evidence validation failed"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "drift/uniqueness_probe.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "argus_verdict": "UNVERIFIED",
            "engine": "lean",
            "obligation_count": 1
          }
        }
      ]
    }
  ]
}